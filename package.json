{
  "name": "buffet-lages",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run generate:menus && npm run generate:routes && npm run generate:images",
    "start": "ng serve",
    "prebuild": "npm run verify:content",
    "build": "ng build",
    "lint": "ng lint",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" angular.json package.json tsconfig*.json eslint.config.js .prettierrc",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run generate:menus && npm run generate:routes",
    "test": "ng test",
    "generate:menus": "node --experimental-strip-types scripts/generate-menus.ts",
    "generate:routes": "node --experimental-strip-types scripts/generate-routes.ts",
    "generate:images": "node --experimental-strip-types scripts/generate-images.ts",
    "test:content": "vitest run --config vitest.content.config.ts",
    "verify:content": "npm run generate:menus && npm run generate:routes && npm run generate:images && tsc -p tsconfig.scripts.json --noEmit && npm run test:content"
  },
  "private": true,
  "engines": {
    "node": "^24.15.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/platform-server": "22.2.6",
    "@angular/router": "22.2.6",
    "@angular/ssr": "22.2.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.6",
    "@eslint/js": "^10.0.1",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@types/node": "^22.12.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "prettier": "3.10.0",
    "sharp": "^0.34.5",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "5.1.0"
  }
}
